{
  "name": "rag-chat-pdf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,analytics -c blue,yellow \"npm:dev\" \"npm:analytics\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "db:test": "node scripts/test-db.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run analytics:lint && npm run analytics:test",
    "analytics": "node scripts/py.mjs -m uvicorn app.main:app --port 8001 --reload",
    "analytics:test": "node scripts/py.mjs -m pytest --cov=app --cov-fail-under=85",
    "analytics:test:integration": "node scripts/py.mjs -m pytest -m integration -v",
    "analytics:lint": "node scripts/py.mjs -m ruff check . && node scripts/py.mjs -m ruff format --check .",
    "analytics:seed": "node scripts/py.mjs scripts/seed_synthetic.py",
    "gen:analytics-types": "node scripts/py.mjs scripts/export_openapi.py && npx -y openapi-typescript@7.13.0 analytics/openapi.json -o lib/analytics-api.d.ts",
    "db:up": "docker compose up -d",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.75",
    "@ai-sdk/react": "^4.0.152",
    "ai": "^7.0.130",
    "mssql": "^12.7.10",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc}": "biome check --write --no-errors-on-unmatched",
    "analytics/**/*.py": [
      "node scripts/py.mjs -m ruff check --fix",
      "node scripts/py.mjs -m ruff format"
    ]
  }
}
