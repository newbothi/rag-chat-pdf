# Base de datos para los tests de integración. Copia este archivo a .env.test.local.
# OJO: la base TEST_DB_NAME se BORRA y se recrea en cada ejecución (debe contener "test").
# El usuario necesita permiso para crear bases de datos (ver db/test-login.sql).
TEST_DB_SERVER=localhost
TEST_DB_PORT=1433
TEST_DB_INSTANCE=
TEST_DB_NAME=RagChat_Test
TEST_DB_USER=rag_test
TEST_DB_PASSWORD=
