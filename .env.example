# Copia este archivo a .env.local y completa los valores

# --- SQL Server 2025 (autenticación SQL) ---
DB_SERVER=localhost
DB_NAME=RagChat
DB_USER=rag_app
DB_PASSWORD=CambiaEstaClave_123
# Solo si usas una instancia con nombre (ej. SQLEXPRESS). Déjalo vacío para la instancia por defecto.
DB_INSTANCE=
# Puerto (déjalo vacío si usas DB_INSTANCE)
DB_PORT=1433
# En local el certificado es autofirmado: deja true
DB_TRUST_CERT=true

# --- Chat (LM Studio en :1234 u Ollama en :11434) ---
CHAT_BASE_URL=http://localhost:1234/v1
# Id exacto del modelo (LM Studio: ver http://localhost:1234/v1/models · Ollama: ej. gemma3:4b)
CHAT_MODEL=gemma-3-4b-it

# --- Embeddings (bge-m3, 1024 dimensiones) ---
EMBEDDING_BASE_URL=http://localhost:1234/v1
# LM Studio: text-embedding-bge-m3 · Ollama: bge-m3
EMBEDDING_MODEL=text-embedding-bge-m3
# Si usas otro modelo de embeddings, ajusta VECTOR(1024) en la base y EMBEDDING_DIMENSIONS en lib/db.ts

# Tamaño máximo de PDF en MB
MAX_UPLOAD_MB=20
