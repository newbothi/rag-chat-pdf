# Copia este archivo a .env.local y completa los valores

# --- SQL Server 2025 (autenticación SQL) ---
DB_SERVER=localhost
DB_NAME=RagChat
DB_USER=rag_app
DB_PASSWORD=CambiaEstaClave_123
# Solo si usas una instancia con nombre (ej. SQLEXPRESS). Déjalo vacío para la instancia por defecto.
DB_INSTANCE=
# Puerto (déjalo vacío si usas DB_INSTANCE)
DB_PORT=1433
# En local el certificado es autofirmado: deja true
DB_TRUST_CERT=true

# --- Ollama (local y gratis, sin API key) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=gemma3:4b
# Si cambias el modelo de embeddings, ajusta VECTOR(1024) en la base y EMBEDDING_DIMENSIONS en lib/db.ts
EMBEDDING_MODEL=bge-m3

# Tamaño máximo de PDF en MB
MAX_UPLOAD_MB=20
